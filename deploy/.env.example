# Legere deployment settings — copy to `.env` next to docker-compose.yaml and edit.
# Only the first block is required; everything else has a working default.

# --- required ---

# The folder holding your documents. Mounted read-only: Legere never writes into it.
LIBRARY_PATH=/mnt/documents

# Four secrets. Generate each with: openssl rand -base64 32
AUTH_SECRET=
POSTGRES_PASSWORD=
# The object store's administrator: the console login and `mc admin`, nothing day-to-day.
MINIO_ROOT_PASSWORD=
# What Legere itself uses. `minio-init` creates a service account with this key and a policy that
# reaches the `legere` bucket and nothing else, so a compromise of the app is not a compromise of the
# object store. Change it and the next `docker compose up` applies the new value.
MINIO_APP_PASSWORD=

# --- addresses ---

# Where you open Legere. Used for links in emails and for the fail-closed CSRF origin check, so it
# has to match what the browser shows, port included.
APP_BASE_URL=http://localhost:3000
APP_PORT=3000

# How the *browser* reaches the bundled MinIO. Legere hands out short-lived signed URLs and the
# browser follows them directly, so this must be resolvable from your machine — and the signature is
# bound to it. Same host as APP_BASE_URL, port MINIO_PORT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PORT=9000

# Both addresses above must be what the browser really uses: APP_BASE_URL is checked against the
# Origin of every mutation (fail-closed), and the presigned URLs are signed for S3_PUBLIC_ENDPOINT.
# Behind TLS, set both to https:// — the session cookie takes its Secure attribute from APP_BASE_URL,
# so nothing else needs changing.

# --- optional ---

# Pin a version instead of following `latest`, e.g. 0.1.0
LEGERE_VERSION=latest
LOG_LEVEL=info

# How much of the container's output is kept, and in how many files. The account journal of
# docs/06 §6.7.1 lives in that output: these two decide how far back it goes, and nothing in Legere
# keeps a copy. Ship the stream elsewhere if you need a history that survives a rotation.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# How much memory each container may use. They are capped so that one expensive document cannot take
# the machine with it; raise the one whose container is killed with exit code 137. Docling gets the
# largest share because a layout parse holds its whole answer in memory while it builds it — a long
# manual is 3–4 GB — and it is the number to lower first on a small box, at the price of documents
# that fail rather than a host that dies.
APP_MEMORY_LIMIT=2g
STIRLING_MEMORY_LIMIT=2g
DOCLING_MEMORY_LIMIT=4g

# The access key of the service account above. Rarely worth changing — it is a name, not a secret.
MINIO_APP_USER=legere-app

# Leave empty unless something in front of the app rewrites X-Forwarded-For. The shipped stack
# publishes the app port directly, so believing that header would let any caller choose their own
# rate-limit bucket. Put a reverse proxy in front and set this to 1 (12 §12.8).
#
# Both mistakes cost, and the second one costs more than it used to. Set here with nothing in front,
# the per-IP rate limits stop existing. Left empty *behind* a proxy, req.ip is the proxy for every
# anonymous caller, so all of them share one allowance of 20 requests per 60 seconds — and the
# sign-in screen spends from it on every load. Twenty page loads a minute and nobody can sign in.
# The app writes one warning line the first time a request arrives with X-Forwarded-For while this
# is empty; if that line appears and there is no proxy, the header came from the caller and this
# must stay empty.
TRUST_PROXY=

# Mail. Every account — the first administrator's included — is created through a six-digit code
# that arrives by email, and that code is written nowhere else: not to `docker compose logs`, not to
# a file. So this is required, and Legere refuses to start without it rather than letting you find
# out at the sign-up form.
#
# Port 465 with SMTP_SECURE=true is TLS from the first byte, and it is the default because the
# alternative cannot be trusted: on 587 the session starts in the clear and is upgraded only if the
# server says STARTTLS — a line an attacker on the path can remove, after which the relay password
# and every six-digit code travel in plaintext and nothing fails (docs/12 §12.8). Almost every
# provider offers 465. If yours does not, SMTP_PORT=587 with SMTP_SECURE=false still works, and you
# are choosing to trust the network between this host and the relay.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Legere <no-reply@example.com>

# Permission to run with no mail server at all: an archive whose accounts already exist, or a relay
# being fixed. Nobody can then sign up, verify an address or finish a password reset.
ALLOW_UNCONFIGURED_EMAIL=false

# Cloudflare Turnstile on the auth forms. Empty = no CAPTCHA, and the server check is a no-op.
TURNSTILE_SECRET_KEY=

# Tesseract languages for the first OCR pass of a scan, joined with `+`. After that each document
# uses the languages detected in its own text, which is more accurate — a narrow set beats a broad
# one, since Cyrillic in the set makes tesseract read "EUR" as "ЕОВ".
OCR_LANGUAGES=rus+eng

# Layout-aware parsing. Empty disables it: Legere then falls back to Stirling's converter, which
# reads the text but flattens headings and tables. Dropping it also lets you skip the docling
# service in docker-compose.yaml, which is several gigabytes.
DOCLING_URL=http://docling:5001

# A caption under every picture in a document, written by a vision model inside the Docling
# container. Off, and worth leaving off: measured at 17 minutes for one page with three small
# pictures on CPU, and the captions describe shapes ("a flag, red and white") rather than meaning.
# The published image does not carry the model — build your own with PICTURE_DESCRIPTION_MODEL
# (docs/12 §12.4), or this answers 404.
DOCLING_PICTURE_DESCRIPTION=false

# An OpenAI-compatible endpoint enables automatic categorization and semantic search. Empty leaves
# both switched off: documents are still found by their text, and the UI says semantic search is
# unavailable rather than pretending.
EMBEDDINGS_API_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# Empty = reuse the embeddings endpoint above.
CLASSIFIER_API_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
