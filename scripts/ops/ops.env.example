# Coordinates of *your* live Legere instance for the scripts/ops/ observability scripts
# (docs/12 §12.8b). Copy to ~/.config/legere/ops.env and `chmod 600` it — this repository is
# public, so none of these values may ever be committed; the scripts read them only from that
# file (or from the path in LEGERE_OPS_ENV).

# --- prod-logs.sh: the host running the app container ---
LEGERE_OPS_APP_SSH=                # ssh destination (an ~/.ssh/config alias keeps keys and ports there)
LEGERE_OPS_APP_CONTAINER=          # the app container's name, e.g. legere-app-1

# --- prod-db.sh: the instance's PostgreSQL, as a READ-ONLY role ---
# 🔒 A role that is read-only by its own privileges (e.g. membership in pg_read_all_data and
# nothing else), never the application's role: the wrapper's session settings are a seat belt,
# not the guarantee.
LEGERE_OPS_DB_HOST=
LEGERE_OPS_DB_PORT=5432
LEGERE_OPS_DB_NAME=
LEGERE_OPS_DB_USER=
LEGERE_OPS_DB_PASSWORD=
