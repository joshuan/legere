{
  "name": "legere",
  "version": "0.17.0",
  "private": true,
  "description": "Self-hosted document management system (external-library model).",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nodemon --quiet --watch server --watch src/server --watch src/shared --ext ts,mjs,json --exec \"node server/dev.mjs\"",
    "dev:up": "docker compose up -d",
    "docling:captions": "docker build -t legere-docling:dev --build-arg PICTURE_DESCRIPTION_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct deploy/docling && docker compose up -d --force-recreate docling",
    "dev:down": "docker compose down",
    "build": "next build && tsc -p tsconfig.server.json && echo '{\"type\":\"commonjs\"}' > dist/package.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "deps:relock": "docker run --rm -v \"$PWD\":/app -w /app node:26-alpine npm install --package-lock-only --ignore-scripts",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --import @swc-node/register/esm-register prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --import @swc-node/register/esm-register prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^3.9.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.2.0",
    "@tanstack/react-query": "^5.62.0",
    "antd": "^5.22.5",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "franc-min": "^6.2.0",
    "nestjs-pino": "^4.2.0",
    "next": "^15.5.23",
    "next-intl": "^4.13.5",
    "nodemailer": "^9.0.5",
    "pg-boss": "^10.1.5",
    "picomatch": "^4.0.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^9.0.1",
    "reflect-metadata": "^0.2.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "postcss": "^8.5.26",
    "sharp": "$sharp",
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^1.19.0",
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.7"
  }
}
