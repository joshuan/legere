{
  "extends": "@joshuan/tooling/tsconfig/web.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/shared/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
