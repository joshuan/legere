{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false,
      "react": {
        "runtime": "automatic"
      }
    },
    "target": "es2022",
    "keepClassNames": true
  },
  "module": {
    "type": "es6"
  }
}
